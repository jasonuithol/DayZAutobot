def ps(opts):
    name = opts["instance"]
    run = read_json(inst_dir(name) / "run.json") or {}
    srun = read_json(server_home() / "run.json") or {}
    return {"ok": True, "bridge": port_open(PORT), "client": {"running": bool(client_pids(name)), "pid": run.get("pid")},
            "server": {"running": bool(server_pid()), "pid": srun.get("pid"), "mission": srun.get("mission")},
            "polling": seen()}


def paths(opts):
    client_dir, server_dir, _ = game_dirs(opts["game"])
    name = opts["instance"]
    return {"ok": True, "repo": str(REPO), "home": str(HOME), "client_dir": str(client_dir), "server_dir": str(server_dir),
            "proton": str(proton_dir()), "prefix": str(inst_dir(name) / "prefix"),
            "profiles": str(profiles_dir(name)), "server_profiles": str(server_home() / "profiles"),
            "autobot_mod": str(REPO if INSTALLED else BUILD / "@DayZAutobot"), "installed": INSTALLED,
            "steam": str(STEAM), "libraries": [str(l) for l in LIBRARIES], "bridge_port": PORT,
            "server_address": f"127.0.0.1:{SERVER_PORT}", "script_log": str(newest_log(profiles_dir(name)) or "")}

# ------------------------------------------------------------------ main

VALUE_OPTS = {"--display", "--instance", "--game", "--connect", "--mods", "--server-mods", "--mission", "--name", "--window",
              "--timeout", "-n", "--grep", "--password", "--wait-secs"}
FLAG_OPTS = {"--no-wait", "--raw", "--wipe", "--server"}


def main(argv):
    opts = {"instance": "default", "game": "stable"}
    rest, extra = [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            extra = argv[i + 1:]
            break
        if a in VALUE_OPTS and i + 1 < len(argv):
            opts[a.lstrip("-").replace("-", "_")] = argv[i + 1]
            i += 2
            continue
        if a in FLAG_OPTS:
            opts[a.lstrip("-").replace("-", "_")] = True
            i += 1
            continue
        if a in ("-h", "--help"):
            print(__doc__)
            return 0
        # an unknown --option used to be passed on as a parameter, which local commands ignore:
        # `cycle --help` rebuilt and restarted everything, a mistyped `--wip` didn't wipe
        if a.startswith("--"):
            die(f"unknown option {a} (options: {', '.join(sorted(VALUE_OPTS | FLAG_OPTS))})")
        rest.append(a)
        i += 1
    opts["extra"] = extra
    if not rest:
        print(__doc__)
        return 0
    raw = opts.get("raw")
    cmd, params = rest[0], rest[1:]

    local = {
        "build": lambda: build(),
        "setup": lambda: build(),
        "launch": lambda: launch(opts),
        "kill": lambda: kill(opts["instance"]),
        "server-start": lambda: server_start(opts),
        "server-stop": lambda: server_stop(),
        "ps": lambda: ps(opts),
        "paths": lambda: paths(opts),
        "cycle": lambda: cycle(opts),
        "join": lambda: send(opts["instance"], "connect", {"address": "127.0.0.1", "port": SERVER_PORT, "timeout": 240}),
    }
    if cmd == "bridge":
        run_bridge(PORT)
        return 0
    restore_cloud()  # if a bot client has exited since it was launched
    if cmd == "log":
        return log_cmd(opts)
    if cmd in local:
        if params:
            die(f"{cmd} takes options (--name value), not {' '.join(params)}")
        r = local[cmd]()
        out(r, raw)
        return 0 if r.get("ok") else 1

    target, prof = opts["instance"], profiles_dir(opts["instance"])
    if cmd == "server":
        if not params:
            die("usage: autobot server <command> [key=value ...]")
        target, prof = "server", server_home() / "profiles"
        cmd, params = params[0], params[1:]
        # an offline client also answers for "server"
    args = {}
    for p in params:
        if "=" not in p:
            die(f"argument '{p}' must be key=value")
        k, v = p.split("=", 1)
        args[k] = v
    if opts.get("timeout"):
        args["timeout"] = opts["timeout"]

    if cmd == "enter" and target != "server":
        r = enter_vehicle(target, args)
    elif cmd == "leave" and target != "server":
        r = leave_vehicle(target, args)
    elif cmd == "screenshot":
        r = screenshot(opts["instance"], args)
    elif cmd == "exec":
        r = exec_cmd(target, prof, args)
    else:
        r = send(target, cmd, args)
    out(r, raw)
    return 0 if r.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
