def _version_key(name):
    return [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", name)]


def proton_dir():
    """PROTON (a name or a path), else the newest GE-Proton in compatibilitytools.d, else Valve's
    Proton from the Steam libraries (Experimental first, then the highest version)."""
    want = os.environ.get("PROTON")
    if want and Path(want).is_absolute():
        return Path(want)
    custom = [p for r in STEAM_ROOTS for p in (r / "compatibilitytools.d").glob("*")
              if "proton" in p.name.lower() and (p / "proton").exists()]
    valve = [p for l in LIBRARIES for p in (l / "steamapps/common").glob("Proton*")
             if (p / "proton").exists() and "BattlEye" not in p.name and "EasyAntiCheat" not in p.name]
    if want:
        for p in custom + valve:
            if p.name == want:
                return p
        die(f"no Proton called {want}")
    if custom:
        return sorted(custom, key=lambda p: _version_key(p.name))[-1]
    exp = [p for p in valve if "Experimental" in p.name]
    if exp:
        return exp[0]
    if valve:
        return sorted(valve, key=lambda p: _version_key(p.name))[-1]
    die("no Proton found: install one in Steam (Library > Tools > Proton), or set PROTON=")


