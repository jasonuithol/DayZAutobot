def newest_log(prof, pattern="script*.log"):
    logs = sorted(Path(prof).glob(pattern), key=lambda p: p.stat().st_mtime)
    return logs[-1] if logs else None


def log_cmd(opts):
    prof = server_home() / "profiles" if opts.get("server") else profiles_dir(opts["instance"])
    f = newest_log(prof)
    if not f:
        die(f"no script log in {prof}")
    lines = f.read_text(errors="replace").splitlines()
    if opts.get("grep"):
        rx = re.compile(opts["grep"])
        lines = [l for l in lines if rx.search(l)]
    n = int(opts.get("n", 40))
    print(f"== {f}")
    print("\n".join(lines[-n:]))
    return 0


def game_to_host(game_path, prof):
    if game_path.startswith("$profile:"):
        return Path(prof) / game_path[len("$profile:"):].replace("\\", "/")
    return Path(game_path)


def proc_env(pid, key):
    try:
        for kv in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"):
            if kv.startswith(key.encode() + b"="):
                return kv.split(b"=", 1)[1].decode()
    except OSError:
        pass
    return None


def client_window(name):
    """The X11 (XWayland) window of this instance's DayZ, matched by _NET_WM_PID to our Proton
    prefix's processes, so a game you run yourself is never captured. Returns (id, display)."""
    pids = set(client_pids(name))
    if not pids:
        return None, None
    display = next((d for d in (proc_env(p, "DISPLAY") for p in pids) if d), os.environ.get("DISPLAY", ":0"))
    env = dict(os.environ, DISPLAY=display)
    tree = subprocess.run(["xwininfo", "-root", "-tree"], capture_output=True, text=True, env=env).stdout
    best = None
    for line in tree.splitlines():
        m = re.match(r"\s*(0x[0-9a-f]+) .*\(\"steam_app_\d+\".*\)\s+(\d+)x(\d+)", line)
        if not m:
            continue
        wid, w, h = m.group(1), int(m.group(2)), int(m.group(3))
        prop = subprocess.run(["xprop", "-id", wid, "_NET_WM_PID"], capture_output=True, text=True, env=env).stdout
        pm = re.search(r"= (\d+)", prop)
        if not pm or int(pm.group(1)) not in pids:
            continue
        info = subprocess.run(["xwininfo", "-id", wid], capture_output=True, text=True, env=env).stdout
        if "IsViewable" not in info:
            continue
        if not best or w * h > best[1]:
            best = (wid, w * h)
    return (best[0] if best else None), display


def screenshot(name, args):
    width = args.pop("width", None)
    hud = str(args.pop("hud", "true")).lower() not in ("false", "0", "no")
    if not client_pids(name):
        return {"ok": False, "error": "the client isn't running"}
    run = read_json(inst_dir(name) / "run.json") or {}
    denv = run.get("display_env")
    shots = inst_dir(name) / "shots"
    shots.mkdir(parents=True, exist_ok=True)
    png = shots / (args.pop("name", time.strftime("%Y%m%d-%H%M%S")) + ".png")
    if denv:
        # headless: grab the nested compositor's output (Xwayland can't read GPU-presented frames)
        cenv = dict({k: v for k, v in os.environ.items() if k != "DISPLAY"}, **denv, QT_QPA_PLATFORM="wayland")
        grab = ["spectacle", "-b", "-n", "-a", "-e", "-o", str(png)]  # the game window, no title bar
    else:
        wid, display = client_window(name)
        if not wid:
            return {"ok": False, "error": "no DayZ window for this instance"}
        cenv = dict(os.environ, DISPLAY=display)
        grab = ["import", "-silent", "-window", wid, str(png)]
    hid = False
    if not hud:
        hid = send(name, "hud", {"show": "false"}, timeout=10).get("ok", False)
        time.sleep(0.25)
    png.unlink(missing_ok=True)
    try:
        c = subprocess.run(grab, capture_output=True, text=True, env=cenv, timeout=30)
    except subprocess.TimeoutExpired:
        c = subprocess.CompletedProcess(grab, 1, "", "timed out")
    if c.returncode == 0 and png.exists() and width:
        subprocess.run(["convert", str(png), "-resize", f"{width}x", str(png)])
    if hid:
        send(name, "hud", {"show": "true"}, timeout=10)
    if c.returncode != 0 or not png.exists():
        return {"ok": False, "error": "capture failed: " + c.stderr.strip()}
    return {"ok": True, "result": {"path": str(png)}}


def exec_cmd(target, prof, args):
    code = args.pop("code", None)
    local = args.pop("file", None)
    if local:
        src = Path(local).read_text()
    elif code is not None:
        src = code if "AB_Run" in code else "string AB_Run()\n{\n" + code + ("\n" if "return" in code else "\nreturn \"\";\n") + "}\n"
    else:
        return {"ok": False, "error": "exec needs code= or file="}
    d = Path(prof) / "autobot/exec"
    d.mkdir(parents=True, exist_ok=True)
    name = "x" + uuid.uuid4().hex[:8] + ".c"
    (d / name).write_text(src)
    log = newest_log(prof)
    start = log.stat().st_size if log else 0
    r = send(target, "exec", dict(args, file=f"$profile:autobot/exec/{name}"))
    if not r.get("ok"):
        log = newest_log(prof)
        if log:
            with open(log, errors="replace") as fh:
                fh.seek(start if log.stat().st_size >= start else 0)
                errs = [l.strip() for l in fh if "error" in l.lower() or "can't compile" in l.lower()]
            if errs:
                r["log"] = errs[-10:]
    else:
        (d / name).unlink(missing_ok=True)
    return r

def approach_path(me, center, entry, clearance=3.0):
    """Waypoints (x, z) to walk from me to just outside a vehicle's door without walking into the
    vehicle: straight there if the way is clear, else round the side of the vehicle nearest to me."""
    import math
    def sub(a, b): return (a[0] - b[0], a[1] - b[1])
    def add(a, b): return (a[0] + b[0], a[1] + b[1])
    def mul(a, k): return (a[0] * k, a[1] * k)
    def norm(a):
        l = math.hypot(a[0], a[1]) or 1.0
        return (a[0] / l, a[1] / l)
    def seg_dist(p, a, b):
        ab, ap = sub(b, a), sub(p, a)
        t = max(0.0, min(1.0, (ap[0] * ab[0] + ap[1] * ab[1]) / ((ab[0] ** 2 + ab[1] ** 2) or 1.0)))
        q = add(a, mul(ab, t))
        return math.hypot(p[0] - q[0], p[1] - q[1])
    me, c, e = (me[0], me[2]), (center[0], center[2]), (entry[0], entry[2])
    out = norm(sub(e, c))                      # from the vehicle's centre out through the door
    stand = add(e, mul(out, 1.2))              # just outside the door
    if seg_dist(c, me, stand) >= clearance:
        return [stand]
    perp = (-out[1], out[0])
    side = perp if (sub(me, c)[0] * perp[0] + sub(me, c)[1] * perp[1]) > 0 else mul(perp, -1)
    corner = add(c, mul(side, 4.5))            # beside the vehicle, on my side
    corner2 = add(c, mul(norm(add(side, out)), 4.5))
    path = [corner] if seg_dist(c, me, corner) < clearance else []
    return path + [corner2, stand]


def enter_vehicle(name, args):
    """Gets into a vehicle seat the way a player does: walk to the seat's door, open it if it's
    shut, get in (hold F). target= is a vehicle id or type (default: the nearest), seat= 0 = driver."""
    target = args.get("target", "")
    seat = int(args.get("seat", 0))
    steps = []

    def step(cmd, a):
        r = send(name, cmd, a)
        steps.append({"cmd": cmd, "ok": r.get("ok"), "error": r.get("error")})
        return r

    q = {"target": target} if target else {}
    parts = step("vehicle_parts", dict(q, radius=args.get("radius", 30)))
    if not parts.get("ok"):
        return dict(parts, steps=steps)
    veh = parts["result"]["id"]
    seats = parts["result"]["seats"]
    if seat >= len(seats):
        return {"ok": False, "error": f"{parts['result']['type']} has {len(seats)} seats", "steps": steps}
    info = seats[seat]
    if info.get("occupant"):
        return {"ok": False, "error": f"seat {seat} is taken", "steps": steps}
    entry = info["entry"]
    veh_info = send(name, "vehicle", {"target": veh})
    me = send(name, "player", {})
    if not veh_info.get("ok") or not me.get("ok"):
        return {"ok": False, "error": "can't read the vehicle or the player", "steps": steps}
    for wx, wz in approach_path(me["result"]["pos"], veh_info["result"]["pos"], entry):
        r = step("move_to", {"x": wx, "z": wz, "radius": 1.0, "speed": 1})
        if not r.get("ok"):
            return dict(r, steps=steps)
    r = step("move_to", {"x": entry[0], "z": entry[2], "radius": 0.5, "speed": 1})
    # a boat's (or a bike's) seat sits inside the hull: you can't walk onto it, but it's in reach
    if not r.get("ok") and r.get("result", {}).get("dist", 99) > 2.5:
        return dict(r, steps=steps)
    if info.get("door") == "DOORS_CLOSED" and info.get("door_id"):
        r = step("action", {"name": "ActionOpenCarDoorsOutside", "target": info["door_id"],
                            "component": info.get("door_entity_component", 0)})
        if not r.get("ok"):
            return dict(r, steps=steps)
        time.sleep(1)
    r = step("action", {"name": "ActionGetInTransport", "target": veh, "seat": seat})
    if not r.get("ok"):
        why = send(name, "actions", {"target": veh, "seat": seat, "why": "true"})
        blocked = [w for w in why.get("result", {}).get("why", []) if w.get("action") == "ActionGetInTransport"]
        return dict(r, steps=steps, why=blocked, seat_info=info)
    for _ in range(20):
        v = send(name, "vehicle", {})
        if v.get("ok") and v["result"].get("my_seat") == seat:
            return {"ok": True, "result": v["result"], "steps": steps}
        time.sleep(0.5)
    return {"ok": False, "error": "the get-in action ran but the player isn't in the seat", "steps": steps}


def leave_vehicle(name, args):
    """Gets out of the vehicle the way a player does: hold F; if the door is shut (only "Open" is
    offered), open it from inside first."""
    steps = []
    acts = send(name, "actions", {})
    offered = [a["action"] for a in acts.get("result", {}).get("actions", [])]
    steps.append({"cmd": "actions", "offered": offered})
    if "ActionGetOutTransport" not in offered and "ActionOpenCarDoors" in offered:
        r = send(name, "action", {"name": "ActionOpenCarDoors"})
        steps.append({"cmd": "action ActionOpenCarDoors", "ok": r.get("ok"), "error": r.get("error")})
        if not r.get("ok"):
            return dict(r, steps=steps)
    r = send(name, "action", {"name": "ActionGetOutTransport"})
    steps.append({"cmd": "action ActionGetOutTransport", "ok": r.get("ok"), "error": r.get("error")})
    if not r.get("ok"):
        return dict(r, steps=steps)
    for _ in range(20):
        v = send(name, "vehicle", {})
        if not v.get("ok"):
            return {"ok": True, "result": send(name, "player", {}).get("result"), "steps": steps}
        time.sleep(0.5)
    return {"ok": False, "error": "still in the vehicle", "steps": steps}


def cycle(opts):
    """Rebuild the mod and restart the server and client with their last settings (they must load
    the same PBOs), then rejoin. Use after changing DayZAutobot or a mod under test."""
    name = opts["instance"]
    srun = read_json(server_home() / "run.json") or {}
    crun = read_json(inst_dir(name) / "run.json") or {}
    had_server, had_client = bool(server_pid()), bool(client_pids(name))
    steps = {}
    if had_client:
        send(name, "quit", timeout=5)
        for _ in range(20):
            if not client_pids(name):
                break
            time.sleep(0.5)
        kill(name)
    if had_server:
        steps["server_stop"] = server_stop()
    if not INSTALLED:
        steps["build"] = build()
    if had_server or opts.get("server"):
        sopts = dict(srun.get("opts", {}), **{k: v for k, v in opts.items() if k in ("mission", "mods", "server_mods", "wipe")})
        sopts.setdefault("game", opts["game"])
        sopts.setdefault("extra", [])
        steps["server"] = r = server_start(sopts)
        if not r.get("ok"):
            return dict(ok=False, error="server didn't start", steps=steps)
    copts = dict(crun.get("opts", {}), instance=name, game=opts["game"], extra=[])
    if opts.get("mods"):
        copts["mods"] = opts["mods"]
    copts.pop("connect", None)
    r = launch(copts)
    steps["client"] = r
    if not r.get("ok"):
        return dict(ok=False, error="client didn't start", steps=steps)
    if had_server or opts.get("server"):
        r = send(name, "connect", {"address": "127.0.0.1", "port": SERVER_PORT, "timeout": 240}, timeout=260)
        return dict(r, steps={k: v.get("ok") for k, v in steps.items()})
    return dict(r, steps={k: v.get("ok") for k, v in steps.items()})


