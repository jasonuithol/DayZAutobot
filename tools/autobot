def _steam_roots():
    h = Path.home()
    cands = [Path(os.environ["STEAM"])] if os.environ.get("STEAM") else []
    cands += [h / ".steam/debian-installation", h / ".steam/steam", h / ".local/share/Steam",
              h / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
    out, seen = [], set()
    for c in cands:
        if (c / "steamapps").is_dir() and c.resolve() not in seen:
            seen.add(c.resolve())
            out.append(c)
    return out


def _steam_libraries():
    libs = []
    for root in _steam_roots():
        libs.append(root)
        try:
            text = (root / "steamapps/libraryfolders.vdf").read_text(errors="replace")
        except OSError:
            continue
        libs += [Path(m.group(1)) for m in re.finditer(r'"path"\s+"([^"]+)"', text)]
    out, seen = [], set()
    for l in libs:
        if (l / "steamapps").is_dir() and l.resolve() not in seen:
            seen.add(l.resolve())
            out.append(l)
    return out


